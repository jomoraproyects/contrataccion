server {
    listen 80;
    listen [::]:80;
    server_name seleccion.empresa.com;
    return 301 https://$host$request_uri;
}

# Rechaza solicitudes que lleguen con un nombre de host desconocido.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/seleccion.empresa.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seleccion.empresa.com/privkey.pem;
    return 444;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name seleccion.empresa.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/seleccion.empresa.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seleccion.empresa.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;

    location /static/ {
        alias /var/www/seleccion/staticfiles/;
        access_log off;
        expires 7d;
    }

    location = /ingresar/ {
        include proxy_params;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://unix:/run/seleccion/gunicorn.sock;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }

    location / {
        include proxy_params;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://unix:/run/seleccion/gunicorn.sock;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }
}
