[Unit]
Description=Procesos de contratación Django
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=notify
User=seleccion
Group=www-data
WorkingDirectory=/var/www/seleccion
EnvironmentFile=/etc/seleccion/seleccion.env
RuntimeDirectory=seleccion
ExecStart=/var/www/seleccion/.venv/bin/gunicorn seleccion_personal.wsgi:application --workers 3 --bind unix:/run/seleccion/gunicorn.sock --access-logfile - --error-logfile - --timeout 60
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
UMask=0027
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
