# Copiar como /etc/seleccion/seleccion.env con propietario root y permisos 600.
SECRET_KEY=GENERE_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_50_CARACTERES
DEBUG=False
ALLOWED_HOSTS=seleccion.empresa.com
CSRF_TRUSTED_ORIGINS=https://seleccion.empresa.com
