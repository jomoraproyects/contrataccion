# Guarde la copia real como /etc/seleccion/seleccion.env con permisos 600.
SECRET_KEY=GENERE_UN_VALOR_LARGO_Y_ALEATORIO
DEBUG=False
ALLOWED_HOSTS=seleccion.empresa.com
CSRF_TRUSTED_ORIGINS=https://seleccion.empresa.com
DATABASE_URL=mysql://seleccion:CAMBIE_ESTA_CLAVE@127.0.0.1:3306/seleccion
DB_CONN_MAX_AGE=600
MYSQL_DATABASE=seleccion
MYSQL_DEFAULTS_FILE=/etc/seleccion/mysql-backup.cnf
BACKUP_DIR=/mnt/respaldos/seleccion
TRUST_PROXY_HEADERS=True
LOG_LEVEL=INFO
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
